# Copy into your deployment environment and replace every example value.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
OIDC_ISSUER=https://identity.example.test/
OIDC_AUDIENCE=health-skill-api
OIDC_JWKS_URL=https://identity.example.test/.well-known/jwks.json
DATABASE_BACKEND=sqlite
DATABASE_PATH=./health-records.sqlite
# For PostgreSQL staging/production, set DATABASE_BACKEND=postgres and inject POSTGRES_URL from a secret manager.
# POSTGRES_URL=postgres://<user>:<password>@<host>:5432/<database>
# POSTGRES_SSL=true
# POSTGRES_AUTO_MIGRATE=false
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
# Graceful shutdown drain timeout (100-120000 ms) and readiness probe timeout (100-30000 ms).
SHUTDOWN_TIMEOUT_MS=10000
READINESS_TIMEOUT_MS=2000
# Infrastructure probes /healthz, /readyz and /metrics are unauthenticated by design.
# Restrict them to a private network or gateway allow-list; never expose them publicly.
